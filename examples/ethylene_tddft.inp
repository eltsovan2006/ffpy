! TD-B3LYP/6-31+G* excited states of ethylene (D2h: give one C and one H)
 $CONTRL SCFTYP=RHF DFTTYP=B3LYP RUNTYP=ENERGY $END
 $BASIS  GBASIS=N31 NGAUSS=6 NDFUNC=1 DIFFSP=.TRUE. $END
 $TDDFT  NSTATE=5 $END
 $DATA
Ethylene
DNH 2

C  6.0   0.0000000   0.0000000   0.6670000
H  1.0   0.0000000   0.9230000   1.2360000
 $END
