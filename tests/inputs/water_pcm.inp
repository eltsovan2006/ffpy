! RHF/6-31G* water in IEF-PCM solvent. Firefly reference expected from user.
 $CONTRL SCFTYP=RHF RUNTYP=ENERGY ISPHER=-1 $END
 $BASIS  GBASIS=N31 NGAUSS=6 NDFUNC=1 $END
 $PCM    SOLVNT=WATER $END
 $DATA
Water
C1
O  8.0   0.0000000   0.0000000   0.1170000
H  1.0   0.0000000   0.7570000  -0.4670000
H  1.0   0.0000000  -0.7570000  -0.4670000
 $END
